{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit|Bash",
        "hooks": [
          { "type": "command", "command": "sh", "args": ["${CLAUDE_PLUGIN_ROOT}/src/easy-diff.sh", "guard"] }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^easy-diff:analyst$",
        "hooks": [
          { "type": "command", "command": "sh", "args": ["${CLAUDE_PLUGIN_ROOT}/src/easy-diff.sh", "check-analysis"] }
        ]
      }
    ]
  }
}
