{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit|Bash",
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/guard.cjs"] }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^easy-diff:analyst$",
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/check-analysis.ts"] }
        ]
      }
    ]
  }
}
